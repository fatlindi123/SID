APP_NAME=SID API
APP_ENVIRONMENT=development
# Replace USER and PASSWORD with a PostgreSQL role and password available locally.
# URL-encode reserved characters in credentials before placing them in the URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/software_intelligence
# Development origins only. Production must list explicit HTTPS frontend origins,
# or use [] when the API is served from the same origin.
CORS_ORIGINS=["http://localhost:8443","http://127.0.0.1:8443","http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
PLAYWRIGHT_BROWSERS_PATH=.cache/playwright
EXPLORATION_MAX_PAGES=20
EXPLORATION_MAX_DEPTH=3
EXPLORATION_PAGE_TIMEOUT_SECONDS=30
EXPLORATION_WORKER_CONCURRENCY=2
INTERACTION_PROBE_TIMEOUT_SECONDS=8
INTERACTION_MAX_PROBES_PER_PAGE=5
INTERACTION_MAX_PROBES_PER_EXPLORATION=30
INTERACTION_MAX_OBSERVATIONS_PER_EXPLORATION=100
INTERACTION_MAX_CANDIDATES_PER_PAGE=30
# Optional OpenAI-compatible chat completions endpoint (local providers are supported).
# AI_API_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=Your-OpenAI-API-Key
# AI_MODEL=your-model-name
# AI_REQUEST_TIMEOUT_SECONDS=60
# AI_ANALYSIS_WORKER_CONCURRENCY=2
# AI_MAX_CONTEXT_ELEMENTS=3000
FRONTEND_BASE_URL=http://127.0.0.1:8443
AUTH_SESSION_TTL_HOURS=168
AUTH_CHALLENGE_TTL_MINUTES=30
# Gmail SMTP is optional for account registration and required for password recovery. Keep credentials in backend/.env.
# Enable 2-Step Verification and create a Google App Password; do not use your Google account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=SID <your-account@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=10
